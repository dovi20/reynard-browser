{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-bridge@reynard.site"
    }
  },
  "name": "Reynard Site Bridge",
  "description": "Connects sites in a site app to iOS: response-finished detection and web notifications.",
  "version": "1.2.0",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "notifications.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "mozillaAddons",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "webRequest",
    "tabs",
    "https://*/*"
  ]
}
