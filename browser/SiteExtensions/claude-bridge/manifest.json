{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-bridge@reynard.site"
    }
  },
  "name": "Reynard Site Bridge (Claude)",
  "description": "Tells the single-site app when Claude starts and finishes a response.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "mozillaAddons",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "webRequest",
    "tabs",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  }
}
